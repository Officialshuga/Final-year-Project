# ============================================================================
# GVU Biometric Staff Attendance — Environment variables
# ----------------------------------------------------------------------------
# COPY this file to ".env" and fill in real values.  NEVER commit the real .env.
#   cp .env.example .env
# ============================================================================

# ---- Flask ----
FLASK_APP=wsgi.py
FLASK_ENV=development            # development | production
SECRET_KEY=change-me-to-a-long-random-string

# ---- Database (MySQL) ----
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://gvu_user:gvu_password@localhost:3306/gvu_attendance

# ---- JWT (JSON Web Tokens) ----
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_ACCESS_TOKEN_MINUTES=30      # access token lifetime (minutes)
JWT_REFRESH_TOKEN_DAYS=7         # refresh token lifetime (days)

# ---- Biometric template encryption (AES) ----
# Must be a URL-safe base64-encoded 32-byte key (Fernet key).
# Generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BIOMETRIC_ENC_KEY=replace-with-generated-fernet-key

# ---- Biometric adapter selection ----
# simulated  -> no hardware needed (testing / development)
# zkteco     -> real ZKTeco matching adapter (pip install pyzkfp on the server)
# secugen    -> real SecuGen matching adapter (FDx SDK)
# NOTE: CAPTURE always happens on the scan station via the local bridge
#       (see /bridge). The server only MATCHES templates, so only the matching
#       SDK needs to be installed here. Switch to real with one line:
#       BIOMETRIC_ADAPTER=zkteco
BIOMETRIC_ADAPTER=simulated

# ---- CORS: the frontend origin(s) allowed to call this API ----
# Comma-separate multiple origins. Match your Vite dev server / deployed URL.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Login security ----
LOGIN_MAX_ATTEMPTS=5             # failed attempts before lockout
LOGIN_LOCKOUT_MINUTES=15        # how long the account is locked
RATELIMIT_LOGIN=10 per minute   # Flask-Limiter rule for the login route

# ---- Attendance rules ----
# Fingerprint match threshold (0-100). Scores >= this are considered a match.
MATCH_THRESHOLD=55

# ---- Password reset (demo: token returned in response; wire email in prod) ----
RESET_TOKEN_MINUTES=30
