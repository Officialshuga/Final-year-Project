# ============================================================================
# Bridge service config. Copy to ".env" and set a strong token.
#   copy .env.example .env        (Windows)
# ============================================================================

# Only this token (sent by the kiosk) may call the bridge. Make it long/random.
BRIDGE_TOKEN=change-me-to-a-long-random-string

# Port the bridge listens on (localhost only).
BRIDGE_PORT=5050

# Which SDK adapter to use: zkteco | secugen | simulated
# "simulated" lets you test the bridge with no hardware attached.
BRIDGE_SENSOR=zkteco

# Capture timeout (seconds) and minimum acceptable quality (0-100).
CAPTURE_TIMEOUT=10
MIN_QUALITY=55

# The kiosk origin allowed to call the bridge (CORS). Keep it local.
KIOSK_ORIGIN=http://localhost:5173
